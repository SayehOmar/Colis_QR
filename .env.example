VITE_TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
VITE_TURNSTILE_ENABLED=false
VITE_GRAPHQL_URI=http://127.0.0.1:8000/graphql
VITE_API_URL=http://127.0.0.1:8000
# Google Cloud OAuth Web client ID (same value in pc-backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=
# Must match pc-backend BYPASS — typing this in the email field skips password
VITE_BYPASS=omaradmin
